# --- Discord -----------------------------------------------------------------
DISCORD_TOKEN=paste-your-bot-token-here
OWNER_ID=your-discord-user-id
DEV_GUILD_ID=your-guild-id

# --- Postgres ----------------------------------------------------------------
# In docker-compose, set the credentials below; DATABASE_URL is built from them.
# For local dev outside Docker, set DATABASE_URL directly.
POSTGRES_USER=topshooter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=topshooter
# Override if running outside the compose network:
# DATABASE_URL=postgres://topshooter:change-me@localhost:5432/topshooter

# --- HTTP API (called by n8n) ------------------------------------------------
# Generate a strong random token, e.g. `openssl rand -hex 32`
BOT_API_TOKEN=

# --- Outbound webhook (bot → n8n events) ------------------------------------
# Set to the URL of the n8n "PKCW Discord Bot — Events Inbox" workflow.
N8N_WEBHOOK_URL=
# Optional shared secret n8n verifies on incoming events:
N8N_WEBHOOK_TOKEN=

# --- Status auto-post --------------------------------------------------------
# Channel where /status auto-posts at 00:00 and 12:00 in STATUS_TIMEZONE.
# Leave empty to disable auto-posting (the manual /status command still works).
STATUS_AUTO_POST_CHANNEL_ID=
STATUS_TIMEZONE=America/Chicago
